generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Tenant {
  id                  String   @id @default(cuid())
  companyName         String
  cloudflareTunnelUrl String?  // Optional now, not strictly needed for push sync
  apiKey              String   // API Key to authenticate with VPS
  dashboardStats      String?  // JSON string containing the latest synced stats
  lastSyncAt          DateTime?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  users               User[]
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("CLIENT") // ADMIN or CLIENT
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
