@{
    Layout = null;
    ViewData["Title"] = "Activación de Licencia";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionQ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .license-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 2.5rem;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            text-align: center;
        }
        .hwid-box {
            background-color: #1e293b;
            border: 1px dashed #64748b;
            padding: 1rem;
            font-size: 1.5rem;
            font-family: monospace;
            color: #38bdf8;
            margin: 1.5rem 0;
            border-radius: 8px;
            user-select: all;
        }
        .form-control {
            background-color: #1e293b;
            border: 1px solid #475569;
            color: #f8fafc;
        }
        .form-control:focus {
            background-color: #1e293b;
            color: #f8fafc;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
        }
        .btn-activate {
            background-color: #10b981;
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-activate:hover {
            background-color: #059669;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="license-card">
        <i class="fa-solid fa-lock" style="font-size: 3rem; color: #ef4444; margin-bottom: 1rem;"></i>
        <h2 style="font-weight: 600; margin-bottom: 0.5rem;">Sistema Bloqueado</h2>
        <p style="color: #94a3b8; font-size: 1.1rem;">Se requiere una licencia válida para utilizar GestionQ en este servidor.</p>
        
        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage) || TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="background-color: rgba(239, 68, 68, 0.2); border-color: #ef4444; color: #fca5a5;">
                @(TempData["ErrorMessage"] ?? ViewBag.ErrorMessage)
            </div>
        }

        <div style="text-align: left; margin-top: 2rem;">
            <label>1. Envíe este <b>Hardware ID</b> a su proveedor:</label>
            <div class="hwid-box">
                @ViewBag.HardwareId
            </div>
        </div>

        <form asp-action="Activate" method="post" style="text-align: left; margin-top: 1.5rem;">
            <label>2. Pegue aquí la <b>Clave de Activación</b> que recibió:</label>
            <textarea name="licenseKey" class="form-control" rows="4" style="margin-top: 0.5rem;" required></textarea>
            
            <div style="text-align: center; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary btn-activate">
                    <i class="fa-solid fa-key"></i> Activar Sistema
                </button>
            </div>
        </form>
    </div>
</body>
</html>
