@model GestionQ.Web.Models.LowStockReportViewModel
@{
    ViewData["Title"] = "Alerta de Stock Crítico y Mínimo";
}

<div class="top-bar no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div class="top-bar-title" style="display: flex; align-items: center; gap: 0.85rem;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: #f59e0b;">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h1 style="margin: 0; font-size: 1.7rem; font-weight: 700; color: #f8fafc;">@ViewData["Title"]</h1>
    </div>
    <div class="top-bar-actions">
        <a asp-action="Index" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Volver a Estadísticas</span>
        </a>
    </div>
</div>

<div class="glass-panel no-print" style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
        <p style="margin: 0; color: var(--text-secondary); font-size: 0.95rem;">
            Listado de productos cuyo stock actual es menor o igual al stock mínimo configurado.
        </p>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button type="button" class="btn-primary" style="padding: 0.5rem 1rem; background: #3b82f6;" onclick="window.print()">
            <i class="fa-solid fa-file-pdf"></i> Imprimir / PDF
        </button>
        <a asp-action="ExportLowStockExcel" class="btn-primary" style="padding: 0.5rem 1rem; background: #10b981;">
            <i class="fa-solid fa-file-excel"></i> Descargar Excel
        </a>
    </div>
</div>

<!-- Header visible only when printing -->
<div class="print-header" style="display: none;">
    <h2 style="margin: 0 0 5px 0;">Alerta de Stock Crítico y Mínimo</h2>
    <p style="margin: 0 0 15px 0; color: #555;">
        <strong>Total de Productos en Alerta:</strong> @Model.TotalAlertCount |
        <strong>Generado:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </p>
</div>

<!-- Tarjetas de Resumen KPI -->
<div class="kpi-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
    <div class="glass-panel kpi-card" style="text-align: center; padding: 1.25rem;">
        <div class="no-print" style="font-size: 2rem; color: #f59e0b; margin-bottom: 0.25rem;">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.25rem;">Total en Alerta</div>
        <div style="font-size: 1.5rem; font-weight: bold; color: #f59e0b;">@Model.TotalAlertCount</div>
    </div>

    <div class="glass-panel kpi-card" style="text-align: center; padding: 1.25rem;">
        <div class="no-print" style="font-size: 2rem; color: #ef4444; margin-bottom: 0.25rem;">
            <i class="fa-solid fa-circle-xmark"></i>
        </div>
        <div style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.25rem;">Agotados (Stock &le; 0)</div>
        <div style="font-size: 1.5rem; font-weight: bold; color: #ef4444;">@Model.OutOfStockCount</div>
    </div>

    <div class="glass-panel kpi-card" style="text-align: center; padding: 1.25rem;">
        <div class="no-print" style="font-size: 2rem; color: #eab308; margin-bottom: 0.25rem;">
            <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <div style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.25rem;">Stock Crítico (&le; Mínimo)</div>
        <div style="font-size: 1.5rem; font-weight: bold; color: #eab308;">@Model.LowStockCount</div>
    </div>
</div>

<div class="glass-panel">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
        <h2 style="margin: 0; display: flex; align-items: center; gap: 0.5rem; font-size: 1.25rem;">
            <i class="fa-solid fa-boxes-packing"></i> Artículos con Quiebre o Bajo Mínimo
        </h2>
        <div class="no-print" style="position: relative;">
            <input type="text" id="lowStockSearch" class="form-control" placeholder="Buscar por código, producto o rubro..." style="padding-left: 2rem; width: 300px;" onkeyup="filterReportTable('lowStockSearch', 'lowStockTable')" />
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-secondary); pointer-events: none;"></i>
        </div>
    </div>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table" id="lowStockTable">
                <thead>
                    <tr>
                        <th style="width: 120px;">Código</th>
                        <th>Producto</th>
                        <th>Categoría / Rubro</th>
                        <th style="text-align: right;">Stock Actual</th>
                        <th style="text-align: right;">Stock Mínimo</th>
                        <th style="text-align: right;">Faltante</th>
                        <th style="text-align: center; width: 120px;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="font-family: monospace; font-size: 0.9rem;">
                                @(!string.IsNullOrEmpty(item.Barcode) ? item.Barcode : item.InternalCode.ToString())
                            </td>
                            <td>
                                <strong>@item.ProductName</strong>
                            </td>
                            <td>
                                <span style="font-size: 0.85rem; color: var(--text-secondary);">@item.CategoryName</span>
                            </td>
                            <td style="text-align: right; font-weight: bold; color: @(item.IsOutOfStock ? "#ef4444" : "#f59e0b");">
                                @item.Stock.ToString("0.##")
                            </td>
                            <td style="text-align: right;">@item.MinimumStock.ToString("0.##")</td>
                            <td style="text-align: right; font-weight: bold; color: #ef4444;">
                                @item.Difference.ToString("0.##")
                            </td>
                            <td style="text-align: center;">
                                @if (item.IsOutOfStock)
                                {
                                    <span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid #ef4444; border-radius: 4px; padding: 2px 8px; font-size: 0.8rem; font-weight: bold;">
                                        Agotado
                                    </span>
                                }
                                else
                                {
                                    <span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid #f59e0b; border-radius: 4px; padding: 2px 8px; font-size: 0.8rem; font-weight: bold;">
                                        Bajo Mínimo
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight: bold; border-top: 2px solid var(--border-color, #475569); background: rgba(255,255,255,0.03);">
                        <td colspan="3" style="text-align: right;">TOTAL ARTÍCULOS EN ALERTA:</td>
                        <td style="text-align: right; color: #f59e0b;">@Model.Items.Sum(i => i.Stock).ToString("0.##")</td>
                        <td style="text-align: right;">@Model.Items.Sum(i => i.MinimumStock).ToString("0.##")</td>
                        <td style="text-align: right; color: #ef4444;">@Model.Items.Sum(i => i.Difference).ToString("0.##")</td>
                        <td style="text-align: center;">@Model.TotalAlertCount ítems</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-circle-check" style="color: #10b981;"></i>
            <p>¡Excelente! Todos los productos están por encima de su nivel de stock mínimo.</p>
        </div>
    }
</div>

<script>
    function filterReportTable(inputId, tableId) {
        var input = document.getElementById(inputId);
        var filter = input.value.toLowerCase();
        var table = document.getElementById(tableId);
        var tr = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");

        for (var i = 0; i < tr.length; i++) {
            var text = tr[i].innerText.toLowerCase();
            tr[i].style.display = text.indexOf(filter) > -1 ? "" : "none";
        }
    }
</script>

<style>
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 1cm;
        }
        * {
            color: black !important;
            text-shadow: none !important;
            box-shadow: none !important;
        }
        body, html {
            background: white !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .top-bar, .no-print, .sidebar, .sidebar-toggle-btn {
            display: none !important;
        }
        .print-header {
            display: block !important;
        }
        .kpi-container {
            display: flex !important;
            justify-content: space-around !important;
            margin-bottom: 15px !important;
            border: 1px solid #ccc !important;
            padding: 8px !important;
        }
        .kpi-card {
            border: none !important;
            padding: 4px !important;
            text-align: center !important;
        }
        .main-content, .container, .container-fluid {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }
        .glass-panel {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .table-responsive {
            overflow: visible !important;
            width: 100% !important;
        }
        table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 9pt !important;
        }
        th, td {
            border: 1px solid #777 !important;
            padding: 4px 6px !important;
            word-wrap: break-word;
        }
        th {
            background: #eee !important;
        }
        tr {
            page-break-inside: avoid;
        }
    }
</style>
