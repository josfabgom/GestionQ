@model List<GestionQ.Web.Models.UpdateManifest>
@{
    ViewData["Title"] = "Actualizaciones del Sistema";
}

<h1 class="page-title">Actualizaciones del Sistema</h1>

<div class="glass-panel" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h3 style="margin: 0; color: var(--accent);">Buscador de Actualizaciones</h3>
            <p style="margin: 0.5rem 0 0 0; opacity: 0.8;">Busca en el servidor web si hay una nueva versión disponible para este equipo.</p>
        </div>
        <form asp-action="LaunchUpdater" method="post">
            <button type="submit" class="btn-primary" style="display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-sync-alt"></i> Buscar Nueva Versión
            </button>
        </form>
    </div>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="text-danger" style="margin-top: 1rem; padding: 1rem; background: rgba(239, 68, 68, 0.1); border-radius: 8px;">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="text-success" style="margin-top: 1rem; padding: 1rem; background: rgba(34, 197, 94, 0.1); border-radius: 8px;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
</div>

<h2 class="page-title" style="font-size: 1.5rem; margin-top: 2rem;">Historial de Versiones Instaladas</h2>

@if (Model == null || !Model.Any())
{
    <div class="glass-panel" style="text-align: center; padding: 3rem;">
        <i class="fas fa-history" style="font-size: 3rem; opacity: 0.3; margin-bottom: 1rem;"></i>
        <p style="opacity: 0.7;">Aún no se han instalado actualizaciones mediante el sistema automático.</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        @foreach (var update in Model)
        {
            <div class="glass-panel">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1rem;">
                    <h3 style="margin: 0;">Versión @update.Version</h3>
                    <span style="opacity: 0.7; font-size: 0.9rem;">
                        <i class="far fa-calendar-alt"></i> @update.ReleaseDate
                    </span>
                </div>
                
                <h4 style="margin: 0 0 0.5rem 0; opacity: 0.9; font-size: 1rem;">Novedades y Correcciones:</h4>
                <ul style="margin: 0; padding-left: 1.5rem; opacity: 0.8;">
                    @foreach (var log in update.Changelog)
                    {
                        <li style="margin-bottom: 0.3rem;">@log</li>
                    }
                </ul>
            </div>
        }
    </div>
}
