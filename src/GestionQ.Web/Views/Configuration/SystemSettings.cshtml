@model GestionQ.Web.Models.ConfigurationViewModel

@{
    ViewData["Title"] = "Ajustes del Sistema";
}

<a asp-action="Index" class="btn-secondary" style="margin-bottom: 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem;">
    <i class="fa-solid fa-arrow-left"></i> Volver a Configuración
</a>

<h1 class="page-title">Ajustes del Sistema</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 1rem; border-radius: 8px; margin-bottom: 2rem;">
        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #6ee7b7; padding: 1rem; border-radius: 8px; margin-bottom: 2rem;">
        <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<form asp-action="SystemSettings" enctype="multipart/form-data">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; align-items: start;">
        
        <!-- PANEL IZQUIERDO: EMPRESA Y TEMA -->
        <div class="glass-panel" style="padding: 1.5rem;">
            <h3 style="margin-top:0; color: #3b82f6; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-building"></i> Identidad de la Empresa
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Información general que se utilizará en tickets, reportes y pantalla general.</p>

            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="CompanyName" class="control-label"></label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="CompanyFantasyName" class="control-label"></label>
                <input asp-for="CompanyFantasyName" class="form-control" />
                <span asp-validation-for="CompanyFantasyName" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="CompanyAddress" class="control-label"></label>
                <input asp-for="CompanyAddress" class="form-control" />
                <span asp-validation-for="CompanyAddress" class="text-danger"></span>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="CompanyPhone" class="control-label"></label>
                    <input asp-for="CompanyPhone" class="form-control" />
                    <span asp-validation-for="CompanyPhone" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="CompanyEmail" class="control-label"></label>
                    <input asp-for="CompanyEmail" type="email" class="form-control" />
                    <span asp-validation-for="CompanyEmail" class="text-danger"></span>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="CompanyCuit" class="control-label"></label>
                    <input asp-for="CompanyCuit" class="form-control" placeholder="Ej: 30-12345678-9" />
                    <span asp-validation-for="CompanyCuit" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="CompanyTaxCondition" class="control-label"></label>
                    <select asp-for="CompanyTaxCondition" class="form-control" style="background: rgba(0,0,0,0.2);">
                        <option value="">Seleccione Condición</option>
                        <option value="Responsable Inscripto">Responsable Inscripto</option>
                        <option value="Monotributista">Monotributista</option>
                        <option value="IVA Exento">IVA Exento</option>
                        <option value="Consumidor Final">Consumidor Final</option>
                    </select>
                    <span asp-validation-for="CompanyTaxCondition" class="text-danger"></span>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="CompanyStartOfActivities" class="control-label"></label>
                    <input asp-for="CompanyStartOfActivities" class="form-control" />
                    <span asp-validation-for="CompanyStartOfActivities" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="CompanyIIBB" class="control-label"></label>
                    <input asp-for="CompanyIIBB" class="form-control" placeholder="Número o 'Exento'" />
                    <span asp-validation-for="CompanyIIBB" class="text-danger"></span>
                </div>
            </div>

            <h3 style="margin-top: 2rem; color: #3b82f6; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-image"></i> Logotipo Empresa
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Sube un archivo de imagen transparente (.png) para reemplazar el diseño de menú lateral y pantalla de login.</p>

            <div class="form-group" style="margin-top: 1rem;">
                <input asp-for="LogoFile" type="file" accept="image/png, image/jpeg" class="form-control" style="background: rgba(0,0,0,0.2); padding: 0.5rem;" />
                <span asp-validation-for="LogoFile" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 1.5rem; text-align: right;">
                <button type="submit" asp-action="UpdateCompanyIdentity" class="btn-secondary" style="padding: 0.5rem 1rem;">
                    <i class="fa-solid fa-save"></i> Guardar Identidad y Logo
                </button>
            </div>

            <h3 style="margin-top: 2rem; color: #a855f7; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-palette"></i> Apariencia y Tema
            </h3>
            <div style="display: flex; gap: 1rem; align-items: flex-end; margin-top: 1rem;">
                <div class="form-group" style="flex: 1; margin: 0;">
                    <select asp-for="UITheme" class="form-control" style="background: rgba(0,0,0,0.2);">
                        <option value="violet">Premium Violeta-Índigo (Por defecto)</option>
                        <option value="emerald">Verde Esmeralda / Cyberpunk</option>
                        <option value="sapphire">Azul Zafiro Clásico</option>
                        <option value="ruby">Rojo Rubí / Carmesí</option>
                        <option value="amber">Naranja Ámbar / Dorado</option>
                    </select>
                    <span asp-validation-for="UITheme" class="text-danger"></span>
                </div>
                <button type="submit" asp-action="UpdateUITheme" class="btn-secondary" style="padding: 0.5rem 1rem;">
                    <i class="fa-solid fa-paint-roller"></i> Aplicar Tema
                </button>
            </div>
        </div>

        <!-- PANEL DERECHO: BD Y OPERACIONES -->
        <div class="glass-panel" style="padding: 1.5rem;">
            <h3 style="margin-top:0; color: #a78bfa; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-database"></i> Conexión SQL Server
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Ajuste los parámetros del motor de base de datos.</p>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="Server" class="control-label"></label>
                <input asp-for="Server" class="form-control" />
                <span asp-validation-for="Server" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="Database" class="control-label"></label>
                <input asp-for="Database" class="form-control" />
                <span asp-validation-for="Database" class="text-danger"></span>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <div class="form-group" style="flex: 1;">
                    <label asp-for="User" class="control-label"></label>
                    <input asp-for="User" class="form-control" />
                    <span asp-validation-for="User" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" type="password" class="form-control" id="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group" style="margin-top: 1rem; text-align: right;">
                <button type="button" class="btn-secondary" style="padding: 0.5rem 1rem;" onclick="testConnection()">
                    <i class="fa-solid fa-plug"></i> Probar Conexión
                </button>
            </div>

            <h3 style="margin-top: 2rem; color: #10b981; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-truck"></i> Configuración de Compras
            </h3>
            
            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="NextInternalSupplierNumber" class="control-label"></label>
                <input asp-for="NextInternalSupplierNumber" type="number" class="form-control" style="max-width: 200px;" />
                <p style="font-size: 0.8rem; opacity: 0.7; margin-top: 0.3rem;">Este número se utilizará automáticamente si el ingreso no tiene número de factura propio.</p>
                <span asp-validation-for="NextInternalSupplierNumber" class="text-danger"></span>
            </div>

            <h3 style="margin-top: 2rem; color: #f59e0b; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-scale-balanced"></i> Configuración de Balanza (Kretz)
            </h3>
            
            <div class="form-group" style="margin-top: 1rem;">
                <label asp-for="JDataGateFolderPath" class="control-label"></label>
                <input asp-for="JDataGateFolderPath" class="form-control" />
                <span asp-validation-for="JDataGateFolderPath" class="text-danger"></span>
            </div>
            
            <div style="margin-top: 1rem; text-align: right;">
                <a asp-controller="Scale" asp-action="Index" class="btn-secondary" style="padding: 0.5rem 1rem; display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="fa-solid fa-file-export"></i> Ir al Módulo Balanza
                </a>
            </div>

            <h3 style="margin-top: 2rem; color: #ef4444; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-download"></i> Respaldo de Base de Datos
            </h3>
            
            <div class="form-group" style="margin-top: 1rem; text-align: right;">
                <a asp-action="BackupDatabase" asp-controller="Configuration" class="btn-secondary" 
                   style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5;"
                   onclick="return confirm('Se generará un respaldo de la base de datos actual. El proceso puede demorar unos segundos. ¿Deseas continuar?');">
                    <i class="fa-solid fa-database"></i> Descargar Backup (.bak)
                </a>
            </div>

            <div class="form-group" style="margin-top: 2.5rem; text-align: right; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;">
                <button type="submit" class="btn-primary" style="padding: 0.8rem 1.5rem; font-size: 1.1rem;"
                    onclick="return confirm('Al aplicar cambios de base de datos el sistema intentará reiniciar momentáneamente. ¿Deseas aplicar los ajustes?')">
                    <i class="fa-solid fa-save"></i> Guardar Todo y Aplicar
                </button>
            </div>
        </div>

    </div>
</form>

<!-- PANELES DE CONEXIONES EXTERNAS -->
<h2 style="margin-top: 3rem; margin-bottom: 1.5rem; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
    Conexiones Externas
</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; align-items: start; margin-bottom: 4rem;">
    
    <!-- Configuración Nube -->
    <div class="glass-panel" style="padding: 1.5rem;">
        <form asp-action="UpdateCloudSettings" method="post">
            <h3 style="margin-top:0; color: #60a5fa; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-cloud"></i> Dashboard Web (Nube)
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Configura hacia dónde enviará el servidor local las estadísticas.</p>
            
            <div class="form-group" style="margin-top: 1rem;">
                <label class="control-label">URL del Dashboard</label>
                <input asp-for="VpsSyncUrl" class="form-control" placeholder="ej: https://galopsrl.com.ar/" />
            </div>
            
            <div class="form-group" style="margin-top: 1rem;">
                <label class="control-label">API Key (Contraseña)</label>
                <input asp-for="DashboardApiKey" class="form-control" type="password" placeholder="tu-super-secreta-api-key" />
            </div>
            
            <div style="margin-top: 1.5rem; text-align: right;">
                <button type="submit" class="btn-primary" style="padding: 0.6rem 1.2rem;" onclick="return confirm('Al cambiar esto y guardar, deberás reiniciar el servidor local de GestionQ manualmente para que comience a sincronizar con la nueva nube. ¿Continuar?')">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Guardar Conexión
                </button>
            </div>
        </form>
    </div>

    <!-- Configuración Ngrok -->
    <div class="glass-panel" style="padding: 1.5rem;">
        <form asp-action="UpdateNgrokSettings" method="post">
            <h3 style="margin-top:0; color: #818cf8; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                <i class="fa-solid fa-mobile-screen"></i> Escáner Móvil (Ngrok)
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Configure el túnel seguro para conectar celulares. Requiere cuenta en ngrok.com.</p>
            
            <div class="form-group" style="margin-top: 1rem;">
                <label class="control-label">Dominio Estático (Domain)</label>
                <input asp-for="NgrokDomain" class="form-control" placeholder="ej: tu-negocio.ngrok-free.app" />
            </div>
            
            <div class="form-group" style="margin-top: 1rem;">
                <label class="control-label">Token de Autenticación</label>
                <input asp-for="NgrokAuthToken" class="form-control" type="password" placeholder="ej: 3GzWWk..." />
            </div>
            
            <div style="margin-top: 1.5rem; text-align: right;">
                <button type="submit" class="btn-primary" style="padding: 0.6rem 1.2rem; background-color: #6366f1; border-color: #6366f1;">
                    <i class="fa-solid fa-satellite-dish"></i> Guardar Túnel
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function testConnection() {
            var data = {
                Server: document.getElementById('Server').value,
                Database: document.getElementById('Database').value,
                User: document.getElementById('User').value,
                Password: document.getElementById('Password').value
            };

            Swal.fire({
                title: 'Probando Conexión...',
                text: 'Por favor espera',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch('/Configuration/TestConnection', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    Swal.fire('¡Éxito!', res.message, 'success');
                } else {
                    Swal.fire('Falló', res.message, 'error');
                }
            })
            .catch(err => {
                Swal.fire('Error', 'No se pudo contactar al servidor para verificar.', 'error');
            });
        }
    </script>
}
