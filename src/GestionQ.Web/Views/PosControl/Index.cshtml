@model IEnumerable<GestionQ.Domain.Entities.PointOfSale>
@{
    ViewData["Title"] = "Tablero de Control de Cajas POS";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title"><i class="fa-solid fa-desktop"></i> Tablero de Control de Cajas POS</h1>
</div>

@if (TempData["Message"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Message"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(34, 197, 94, 0.2); border: 1px solid #22c55e; color: #86efac; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="glass-card" style="margin-bottom: 2rem; border-left: 5px solid #007bff; display: flex; align-items: center; justify-content: space-between;">
    <div>
        <h3 style="margin: 0; color: #f8f9fa;"><i class="fa-solid fa-boxes-stacked"></i> Actualización de Catálogo a Cajas</h3>
        <p style="margin: 0.5rem 0 0 0; color: #a1a1aa; font-size: 0.95rem;">
            Último envío autorizado: <strong style="color: #fff;">@ViewBag.LastApprovedDate</strong><br>
            Hay <strong style="color: #ffc107; font-size: 1.1rem;">@ViewBag.PendingProductsCount</strong> artículos o precios nuevos/modificados esperando ser enviados a las terminales POS.
        </p>
    </div>
    <div style="display: flex; gap: 1rem; align-items: center;">
        <a asp-action="SyncHistory" class="btn btn-secondary" style="font-size: 1rem; padding: 0.8rem 1.2rem;">
            <i class="fa-solid fa-clock-rotate-left"></i> Ver Historial de Envíos
        </a>
        <form asp-action="AuthorizeProductSync" method="post" style="margin: 0;">
            <button type="submit" class="btn btn-primary" style="font-size: 1.1rem; padding: 0.8rem 1.5rem;" @(ViewBag.PendingProductsCount == 0 ? "disabled" : "")>
                <i class="fa-solid fa-cloud-arrow-up"></i> Enviar Cambios a Cajas POS
            </button>
        </form>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
    @foreach (var pos in Model)
    {
        var activeRegister = pos.CashRegisters.FirstOrDefault(); // There should be at most 1 open register due to the query filter
        bool isOpen = activeRegister != null;
        
        decimal totalEfectivo = 0;
        decimal ingresos = 0;
        decimal egresos = 0;
        decimal saldoEsperado = 0;
        decimal totalVentas = 0;
        int cantVentas = 0;

        if (isOpen)
        {
            totalEfectivo = activeRegister.Sales.SelectMany(s => s.Payments).Where(p => p.PaymentMethod?.Name == "Efectivo").Sum(p => p.Amount);
            ingresos = activeRegister.Movements.Where(m => m.Type == "Ingreso").Sum(m => m.Amount);
            egresos = activeRegister.Movements.Where(m => m.Type == "Egreso").Sum(m => m.Amount);
            saldoEsperado = activeRegister.InitialBalance + totalEfectivo + ingresos - egresos;
            totalVentas = activeRegister.Sales.Sum(s => s.TotalAmount);
            cantVentas = activeRegister.Sales.Count;
        }

        <div class="glass-panel" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
                <h3 style="margin: 0; font-size: 1.25rem;">@pos.Name</h3>
                @if (isOpen)
                {
                    <span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 0.3rem 0.6rem; border-radius: 6px; font-weight: bold; font-size: 0.8rem;">
                        <i class="fa-solid fa-circle-check"></i> ABIERTA
                    </span>
                }
                else
                {
                    <span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; padding: 0.3rem 0.6rem; border-radius: 6px; font-weight: bold; font-size: 0.8rem;">
                        <i class="fa-solid fa-circle-xmark"></i> CERRADA
                    </span>
                }
            </div>

            @{
                DateTime? approvedDate = ViewBag.LastApprovedDateObj;
                bool isUpdated = false;
                if (approvedDate == null)
                {
                    isUpdated = true; // No updates ever authorized
                }
                else if (pos.LastSyncDate != null && pos.LastSyncDate.Value >= approvedDate.Value)
                {
                    isUpdated = true;
                }
            }

            <div style="font-size: 0.85rem; padding: 0.5rem; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; background: @(isUpdated ? "rgba(34, 197, 94, 0.1)" : "rgba(234, 179, 8, 0.1)"); border: 1px solid @(isUpdated ? "rgba(34, 197, 94, 0.2)" : "rgba(234, 179, 8, 0.2)");">
                <span style="color: @(isUpdated ? "#4ade80" : "#fef08a");">
                    <i class="fa-solid @(isUpdated ? "fa-check-circle" : "fa-triangle-exclamation")"></i> 
                    Catálogo: <strong>@(isUpdated ? "Actualizado" : "Desactualizado")</strong>
                </span>
                <span style="color: #9ca3af; font-size: 0.75rem;">
                    @if (pos.LastSyncDate != null)
                    {
                        @pos.LastSyncDate.Value.ToString("HH:mm")
                    }
                    else
                    {
                        <text>--:--</text>
                    }
                </span>
            </div>

            <div style="flex-grow: 1; font-size: 0.95rem;">
                @if (isOpen)
                {
                    <p style="margin: 0.2rem 0; color: var(--text-muted);"><i class="fa-solid fa-user"></i> Cajero: <strong style="color: white;">@activeRegister.User?.UserName</strong></p>
                    <p style="margin: 0.2rem 0; color: var(--text-muted);"><i class="fa-solid fa-clock"></i> Apertura: <strong style="color: white;">@activeRegister.OpeningDate.ToString("dd/MM/yy HH:mm")</strong></p>

                    <div style="background: rgba(59, 130, 246, 0.1); border-radius: 8px; padding: 1rem; margin-top: 1rem;">
                        <p style="margin: 0; font-size: 0.85rem; color: #93c5fd;">Ventas en Sesión (@cantVentas)</p>
                        <h2 style="margin: 0; color: #60a5fa; font-size: 1.5rem;">$@totalVentas.ToString("N2")</h2>
                        
                        <p style="margin: 0.5rem 0 0 0; font-size: 0.85rem; color: #6ee7b7;">Efectivo en Caja</p>
                        <h3 style="margin: 0; color: #10b981; font-size: 1.25rem;">$@saldoEsperado.ToString("N2")</h3>
                    </div>
                }
                else
                {
                    <div style="display: flex; align-items: center; justify-content: center; height: 100px; color: var(--text-muted); flex-direction: column;">
                        <i class="fa-solid fa-cash-register" style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                        <span>No hay caja activa</span>
                    </div>
                }
            </div>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border);">
                <a asp-action="Details" asp-route-id="@pos.Id" class="btn-primary" style="width: 100%; text-align: center; display: block; box-sizing: border-box;">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Ver Detalles y Reportes
                </a>
            </div>
        </div>
    }
</div>
