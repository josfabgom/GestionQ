@model IEnumerable<GestionQ.Domain.Entities.PointOfSale>
@{
    ViewData["Title"] = "Tablero de Control de Cajas POS";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title"><i class="fa-solid fa-desktop"></i> Tablero de Control de Cajas POS</h1>
</div>

@if (TempData["Message"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Message"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(34, 197, 94, 0.2); border: 1px solid #22c55e; color: #86efac; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="glass-card" style="margin-bottom: 2rem; border-left: 5px solid #007bff; display: flex; align-items: center; justify-content: space-between;">
    <div>
        <h3 style="margin: 0; color: #f8f9fa;"><i class="fa-solid fa-boxes-stacked"></i> Actualización de Catálogo a Cajas</h3>
        <p style="margin: 0.5rem 0 0 0; color: #a1a1aa; font-size: 0.95rem;">
            Último envío autorizado: <strong style="color: #fff;">@ViewBag.LastApprovedDate</strong><br>
            Hay <strong style="color: #ffc107; font-size: 1.1rem;">@ViewBag.PendingProductsCount</strong> artículos o precios nuevos/modificados esperando ser enviados a las terminales POS.
        </p>
    </div>
    <div style="display: flex; gap: 1rem; align-items: center;">
        <a asp-action="SyncHistory" class="btn btn-secondary" style="font-size: 1rem; padding: 0.8rem 1.2rem;">
            <i class="fa-solid fa-clock-rotate-left"></i> Ver Historial de Envíos
        </a>
        <form asp-action="AuthorizeProductSync" method="post" style="margin: 0;">
            <button type="submit" class="btn btn-primary" style="font-size: 1.1rem; padding: 0.8rem 1.5rem;" @(ViewBag.PendingProductsCount == 0 ? "disabled" : "")>
                <i class="fa-solid fa-cloud-arrow-up"></i> Enviar Cambios a Cajas POS
            </button>
        </form>
    </div>
</div>

@{
    decimal globalTotalVentas = 0;
    decimal globalEfectivo = 0;
    int globalCajasAbiertas = 0;
    var globalPaymentBreakdown = new Dictionary<string, decimal>();

    foreach (var pos in Model)
    {
        var activeRegister = pos.CashRegisters.FirstOrDefault();
        if (activeRegister != null)
        {
            globalCajasAbiertas++;
            globalTotalVentas += activeRegister.Sales.Where(s => !s.IsCancelled).Sum(s => s.TotalAmount);
            var ingresos = Math.Abs(activeRegister.Movements.Where(m => m.Type == "Ingreso").Sum(m => m.Amount));
            var egresos = Math.Abs(activeRegister.Movements.Where(m => m.Type == "Egreso").Sum(m => m.Amount));
            var efe = activeRegister.Sales.Where(s => !s.IsCancelled).SelectMany(s => s.Payments).Where(p => p.PaymentMethod?.Name == "Efectivo").Sum(p => p.Amount);
            globalEfectivo += activeRegister.InitialBalance + efe + ingresos - egresos;

            var payments = activeRegister.Sales.Where(s => !s.IsCancelled).SelectMany(s => s.Payments);
            foreach (var p in payments)
            {
                var method = p.PaymentMethod != null ? p.PaymentMethod.Name : "Otro";
                if (!globalPaymentBreakdown.ContainsKey(method))
                {
                    globalPaymentBreakdown[method] = 0;
                }
                globalPaymentBreakdown[method] += p.Amount;
            }
        }
    }
}

<div class="glass-card" style="margin-bottom: 2rem; border-left: 5px solid #10b981; display: flex; flex-wrap: wrap; gap: 2rem; align-items: stretch; justify-content: space-between;">
    <div style="flex: 1.5; min-width: 250px;">
        <h3 style="margin: 0 0 1rem 0; color: #f8f9fa;"><i class="fa-solid fa-chart-line"></i> Resumen Global (Cajas Abiertas: @globalCajasAbiertas)</h3>
        
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
            <div style="background: rgba(59, 130, 246, 0.1); border-radius: 8px; padding: 1rem; border: 1px solid rgba(59, 130, 246, 0.2); flex: 1; min-width: 150px;">
                <p style="margin: 0; font-size: 0.85rem; color: #93c5fd; font-weight: bold;">TOTAL VENTAS GLOBAL</p>
                <h2 style="margin: 0.5rem 0 0 0; color: #60a5fa; font-size: 1.8rem; font-weight: bold;">$@globalTotalVentas.ToString("N2")</h2>
            </div>
            
            <div style="background: rgba(16, 185, 129, 0.1); border-radius: 8px; padding: 1rem; border: 1px solid rgba(16, 185, 129, 0.2); flex: 1; min-width: 150px;">
                <p style="margin: 0; font-size: 0.85rem; color: #6ee7b7; font-weight: bold;">EFECTIVO GLOBAL ESPERADO</p>
                <h2 style="margin: 0.5rem 0 0 0; color: #10b981; font-size: 1.8rem; font-weight: bold;">$@globalEfectivo.ToString("N2")</h2>
            </div>
        </div>
    </div>
    
    <div style="flex: 2; min-width: 300px; background: rgba(255, 255, 255, 0.03); border-radius: 8px; padding: 1rem; border: 1px solid rgba(255, 255, 255, 0.05);">
        <h4 style="margin: 0 0 0.8rem 0; font-size: 0.9rem; color: #d1d5db; border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 0.5rem;">Desglose Global por Medios de Pago</h4>
        
        @if (globalPaymentBreakdown.Any())
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.8rem;">
                @foreach (var pb in globalPaymentBreakdown.OrderByDescending(x => x.Value))
                {
                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #bfdbfe; background: rgba(0,0,0,0.2); padding: 0.5rem 0.8rem; border-radius: 6px;">
                        <span>@pb.Key</span>
                        <strong>$@pb.Value.ToString("N2")</strong>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="font-size: 0.9rem; color: #9ca3af; font-style: italic; padding: 1rem 0; text-align: center;">Sin pagos registrados en cajas abiertas</div>
        }
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
    @foreach (var pos in Model)
    {
        var activeRegister = pos.CashRegisters.FirstOrDefault(); // There should be at most 1 open register due to the query filter
        bool isOpen = activeRegister != null;
        
        decimal totalEfectivo = 0;
        decimal ingresos = 0;
        decimal egresos = 0;
        decimal saldoEsperado = 0;
        decimal totalVentas = 0;
        int cantVentas = 0;
        var validSales = new List<GestionQ.Domain.Entities.Sale>();

        if (isOpen)
        {
            validSales = activeRegister.Sales.Where(s => !s.IsCancelled).ToList();
            totalEfectivo = validSales.SelectMany(s => s.Payments).Where(p => p.PaymentMethod?.Name == "Efectivo").Sum(p => p.Amount);
            ingresos = Math.Abs(activeRegister.Movements.Where(m => m.Type == "Ingreso").Sum(m => m.Amount));
            egresos = Math.Abs(activeRegister.Movements.Where(m => m.Type == "Egreso").Sum(m => m.Amount));
            saldoEsperado = activeRegister.InitialBalance + totalEfectivo + ingresos - egresos;
            totalVentas = validSales.Sum(s => s.TotalAmount);
            cantVentas = validSales.Count;
        }

        <div class="glass-panel" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
                <h3 style="margin: 0; font-size: 1.25rem;">@pos.Name</h3>
                @if (isOpen)
                {
                    <span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 0.3rem 0.6rem; border-radius: 6px; font-weight: bold; font-size: 0.8rem;">
                        <i class="fa-solid fa-circle-check"></i> ABIERTA
                    </span>
                }
                else
                {
                    <span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; padding: 0.3rem 0.6rem; border-radius: 6px; font-weight: bold; font-size: 0.8rem;">
                        <i class="fa-solid fa-circle-xmark"></i> CERRADA
                    </span>
                }
            </div>

            @{
                DateTime? approvedDate = ViewBag.LastApprovedDateObj;
                bool isUpdated = false;
                if (approvedDate == null)
                {
                    isUpdated = true; // No updates ever authorized
                }
                else if (pos.LastSyncDate != null && pos.LastSyncDate.Value >= approvedDate.Value)
                {
                    isUpdated = true;
                }
            }

            <div style="font-size: 0.85rem; padding: 0.5rem; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; background: @(isUpdated ? "rgba(34, 197, 94, 0.1)" : "rgba(234, 179, 8, 0.1)"); border: 1px solid @(isUpdated ? "rgba(34, 197, 94, 0.2)" : "rgba(234, 179, 8, 0.2)");">
                <span style="color: @(isUpdated ? "#4ade80" : "#fef08a");">
                    <i class="fa-solid @(isUpdated ? "fa-check-circle" : "fa-triangle-exclamation")"></i> 
                    Catálogo: <strong>@(isUpdated ? "Actualizado" : "Desactualizado")</strong>
                </span>
                <span style="color: #9ca3af; font-size: 0.75rem;">
                    @if (pos.LastSyncDate != null)
                    {
                        @pos.LastSyncDate.Value.ToString("HH:mm")
                    }
                    else
                    {
                        <text>--:--</text>
                    }
                </span>
            </div>

            <div style="flex-grow: 1; font-size: 0.95rem;">
                @if (isOpen)
                {
                    <p style="margin: 0.2rem 0; color: var(--text-muted);"><i class="fa-solid fa-user"></i> Cajero: <strong style="color: white;">@activeRegister.User?.UserName</strong></p>
                    <p style="margin: 0.2rem 0; color: var(--text-muted);"><i class="fa-solid fa-clock"></i> Apertura: <strong style="color: white;">@activeRegister.OpeningDate.ToString("dd/MM/yy HH:mm")</strong></p>

                                        <div style="background: rgba(16, 185, 129, 0.1); border-radius: 8px; padding: 1rem; margin-top: 1rem;">
                        <p style="margin: 0; font-size: 0.85rem; color: #6ee7b7;">Total Efectivo en Caja</p>
                        <h3 style="margin: 0; color: #10b981; font-size: 1.5rem;">$@saldoEsperado.ToString("N2")</h3>
                        <p style="margin: 0.2rem 0 0 0; font-size: 0.75rem; color: #a7f3d0;">
                            (Efectivo Inicial: $@activeRegister.InitialBalance.ToString("N2"))
                        </p>
                        @if (ingresos > 0 || egresos > 0)
                        {
                            <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed rgba(16, 185, 129, 0.3); font-size: 0.8rem; color: #a7f3d0;">
                                @if (ingresos > 0) {
                                    <div style="display: flex; justify-content: space-between;">
                                        <span>Entradas / Ingresos:</span>
                                        <strong>+$@ingresos.ToString("N2")</strong>
                                    </div>
                                }
                                @if (egresos > 0) {
                                    <div style="display: flex; justify-content: space-between; color: #fca5a5;">
                                        <span>Retiros / Egresos:</span>
                                        <strong>-$@egresos.ToString("N2")</strong>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div style="background: rgba(59, 130, 246, 0.1); border-radius: 8px; padding: 1rem; margin-top: 0.5rem;">
                        <p style="margin: 0; font-size: 0.85rem; color: #93c5fd; font-weight: bold;">Desglose de Ventas (@cantVentas):</p>
                        
                        <div style="margin: 0.5rem 0; padding: 0.5rem 0; border-top: 1px dashed rgba(96, 165, 250, 0.3); border-bottom: 1px dashed rgba(96, 165, 250, 0.3);">
                            @{
                                var paymentBreakdown = validSales
                                    .SelectMany(s => s.Payments)
                                    .GroupBy(p => p.PaymentMethod != null ? p.PaymentMethod.Name : "Otro")
                                    .Select(g => new { Method = g.Key, Amount = g.Sum(x => x.Amount) })
                                    .ToList();

                                if (paymentBreakdown.Any())
                                {
                                    foreach(var pb in paymentBreakdown)
                                    {
                                        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #bfdbfe; margin-bottom: 0.2rem;">
                                            <span>@pb.Method</span>
                                            <strong>$@pb.Amount.ToString("N2")</strong>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="font-size: 0.85rem; color: #bfdbfe; font-style: italic;">Sin pagos registrados</div>
                                }
                            }
                        </div>
                        
                        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 0.5rem;">
                            <span style="font-size: 0.9rem; color: #93c5fd; font-weight: bold;">TOTAL VENTAS:</span>
                            <h2 style="margin: 0; color: #60a5fa; font-size: 1.3rem; font-weight: bold;">$@totalVentas.ToString("N2")</h2>
                        </div>
                        @{
                            var cancelledSales = activeRegister.Sales.Where(s => s.IsCancelled).ToList();
                            if (cancelledSales.Any())
                            {
                                var totalAnuladas = cancelledSales.Sum(s => s.TotalAmount);
                                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 0.5rem; color: #f87171; border-top: 1px dashed rgba(248, 113, 113, 0.3); padding-top: 0.5rem;">
                                    <span style="font-size: 0.8rem; font-weight: bold;">ANULADAS (@cancelledSales.Count):</span>
                                    <span style="font-size: 0.9rem; font-weight: bold;">$@totalAnuladas.ToString("N2")</span>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div style="display: flex; align-items: center; justify-content: center; height: 100px; color: var(--text-muted); flex-direction: column;">
                        <i class="fa-solid fa-cash-register" style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                        <span>No hay caja activa</span>
                    </div>
                }
            </div>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border);">
                <a asp-action="Details" asp-route-id="@pos.Id" class="btn-primary" style="width: 100%; text-align: center; display: block; box-sizing: border-box;">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Ver Detalles y Reportes
                </a>
            </div>
        </div>
    }
</div>







