@model IEnumerable<GestionQ.Domain.Entities.CentralCashMovement>

@{
    ViewData["Title"] = "Caja Central de Gestión";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title" style="margin-bottom: 0;"><i class="fa-solid fa-vault" style="color: #10b981;"></i> Caja Central</h1>
    
    <div style="text-align: right; background: rgba(16, 185, 129, 0.1); padding: 1rem 2rem; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.2);">
        <div style="font-size: 0.9rem; opacity: 0.8;">Saldo Actual en Administración</div>
        <div style="font-size: 2rem; font-weight: 700; color: #10b981;">@ViewBag.CurrentBalance.ToString("C2")</div>
    </div>
</div>

<div class="glass-panel" style="margin-bottom: 2rem;">
    <form asp-action="Index" method="get" style="display: flex; gap: 1rem; align-items: flex-end;">
        <div>
            <label style="display: block; margin-bottom: 0.5rem;">Desde</label>
            <input type="date" name="startDate" value="@(ViewBag.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" style="background: rgba(255,255,255,0.05);" />
        </div>
        <div>
            <label style="display: block; margin-bottom: 0.5rem;">Hasta</label>
            <input type="date" name="endDate" value="@(ViewBag.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" style="background: rgba(255,255,255,0.05);" />
        </div>
        <div>
            <button type="submit" class="btn-primary" style="padding: 0.8rem 1.5rem;">Filtrar</button>
            <a asp-action="Index" class="btn-secondary" style="padding: 0.8rem 1.5rem;">Limpiar</a>
        </div>
    </form>
</div>

<div class="glass-panel">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="margin: 0;">Historial de Movimientos</h3>
        <button type="button" class="btn-primary" onclick="document.getElementById('manualMovementModal').style.display='block'">+ Ajuste Manual</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Fecha y Hora</th>
                <th>Tipo</th>
                <th>Concepto</th>
                <th>Usuario</th>
                <th style="text-align: right;">Monto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (item.Type == "Ingreso")
                        {
                            <span class="badge" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">Ingreso</span>
                        }
                        else
                        {
                            <span class="badge" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">Egreso</span>
                        }
                    </td>
                    <td>@item.Concept</td>
                    <td style="opacity: 0.7;">@(item.User?.UserName ?? "Sistema")</td>
                    <td style="text-align: right; font-weight: 600; color: @(item.Type == "Ingreso" ? "#10b981" : "#ef4444")">
                        @(item.Type == "Ingreso" ? "+" : "-") @item.Amount.ToString("C2")
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" style="text-align: center; opacity: 0.5; padding: 2rem;">No hay movimientos registrados en este período.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Movimiento Manual -->
<div id="manualMovementModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
    <div class="glass-panel" style="width: 400px; padding: 2rem;">
        <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Registrar Ajuste Manual</h3>
        <form asp-action="CreateMovement" method="post">
            <div style="margin-bottom: 1rem;">
                <label>Tipo de Movimiento</label>
                <select name="Type" class="form-control" style="background: rgba(0,0,0,0.3); width: 100%; padding: 0.8rem; margin-top: 0.5rem;" required>
                    <option value="Ingreso">Ingreso (Aporte, Depósito a Caja)</option>
                    <option value="Egreso">Egreso (Retiro manual, Faltante)</option>
                </select>
            </div>
            <div style="margin-bottom: 1rem;">
                <label>Monto</label>
                <input type="number" name="Amount" step="0.01" class="form-control" style="background: rgba(0,0,0,0.3); width: 100%; padding: 0.8rem; margin-top: 0.5rem;" required />
            </div>
            <div style="margin-bottom: 1.5rem;">
                <label>Concepto</label>
                <input type="text" name="Concept" class="form-control" style="background: rgba(0,0,0,0.3); width: 100%; padding: 0.8rem; margin-top: 0.5rem;" required />
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 1rem;">
                <button type="button" class="btn-secondary" onclick="document.getElementById('manualMovementModal').style.display='none'">Cancelar</button>
                <button type="submit" class="btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>
<script>
    document.getElementById('manualMovementModal').style.display = 'none';
</script>
<style>.badge { padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600; }</style>

