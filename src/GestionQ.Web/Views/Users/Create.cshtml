@model GestionQ.Web.Controllers.CreateUserViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}
<h1 class="page-title">Nuevo Usuario</h1>

<div class="glass-panel" style="max-width: 500px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger" style="color: #ef4444; margin-bottom: 1rem; font-size: 0.9rem;"></div>
        <div class="form-group">
            <label asp-for="UserName">Nombre de Usuario (Login)</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="FullName">Nombre para Ticket (Opcional)</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password">Contraseña</label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Role">Asignar Rol</label>
            <select asp-for="Role" class="form-control">
                <option value="">Seleccione un Rol (Opcional)</option>
                @foreach (var role in ViewBag.Roles as IEnumerable<string>)
                {
                        <option value="@role">@role</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Pin">PIN de Caja (Opcional, 4 dígitos)</label>
            <input asp-for="Pin" type="number" maxlength="4" class="form-control" placeholder="Ej: 1234" />
            <span asp-validation-for="Pin" class="text-danger"></span>
        </div>
        <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Registrar Usuario</button>
            <a asp-action="Index" class="btn-secondary">Volver</a>
        </div>
    </form>
</div>
