@{
    ViewData["Title"] = "Etiquetas de Balanza (Manual)";
}

<div class="glass-panel" style="max-width: 600px; margin: 0 auto; margin-top: 2rem;">
    <h2 style="color: #8b5cf6; margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-scale-balanced"></i> Etiquetas de Balanza
    </h2>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem;">
        Genera códigos de barras tipo balanza (pesables o unitarios) e imprímelos en una etiquetadora térmica normal.
    </p>

    <form asp-action="PrintScalePreview" method="post" id="scaleForm" target="_blank">
        
        <div class="form-group">
            <label>1. Buscar y Seleccionar Producto</label>
            <input type="text" id="productSearch" list="productsList" class="form-control" placeholder="Escribe el nombre o código..." autocomplete="off" style="font-size: 1.1rem; padding: 0.75rem;" />
            <datalist id="productsList">
                @if (ViewBag.Products != null)
                {
                    foreach (var item in ViewBag.Products)
                    {
                        var pesableStr = item.IsPesable ? "true" : "false";
                        // Usar ToString("F2", System.Globalization.CultureInfo.InvariantCulture) para el precio para asegurar punto decimal en JS
                        <option value="@item.InternalCode - @item.Name" data-id="@item.Id" data-price="@item.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" data-pesable="@pesableStr"></option>
                    }
                }
            </datalist>
            
            <input type="hidden" id="productId" name="productId" />
            <input type="hidden" id="productPrice" value="0" />
            <input type="hidden" id="isPesable" value="false" />
        </div>

        <div class="form-group" id="amountGroup" style="display: none;">
            <label id="amountLabel">2. Peso (kg)</label>
            <input type="number" id="amount" name="amount" class="form-control" step="0.001" min="0.001" required autocomplete="off" style="font-size: 1.5rem; padding: 1rem; text-align: center; font-weight: bold; color: #3b82f6;" />
            <small id="amountHelp" style="color: #94a3b8; display: block; margin-top: 0.5rem; text-align: center;">Ejemplo: Para 250 gramos, escribe 0.250</small>
        </div>

        <div id="priceResultCard" style="display: none; background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; text-align: center;">
            <div style="color: #94a3b8; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">Importe Calculado</div>
            <div id="calculatedTotal" style="font-size: 3rem; font-weight: 900; color: #10b981;">$0.00</div>
            <div id="unitPriceLabel" style="color: #64748b; font-size: 0.85rem; margin-top: 0.5rem;">Precio unitario: $0.00</div>
        </div>

        <div class="row" style="margin-top: 1.5rem;">
            <div class="col-md-6 form-group">
                <label>Cantidad de Etiquetas</label>
                <input type="number" name="quantity" class="form-control" value="1" min="1" max="100" required />
            </div>
            <div class="col-md-6 form-group">
                <label>Formato de Impresión</label>
                <select name="format" class="form-control">
                    <option value="50x35">50x35mm (Térmica)</option>
                    <option value="80x33">Góndola Térmica (80x33mm)</option>
                </select>
            </div>
        </div>

        <div style="margin-top: 2rem;">
            <button type="submit" class="btn-primary" style="width: 100%; padding: 1rem; font-size: 1.1rem; background: #3b82f6; border-color: #3b82f6;" id="btnPrint" disabled>
                <i class="fa-solid fa-print"></i> Generar e Imprimir Etiqueta
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById('productSearch');
            const productIdInput = document.getElementById('productId');
            const productPriceInput = document.getElementById('productPrice');
            const isPesableInput = document.getElementById('isPesable');
            const amountGroup = document.getElementById('amountGroup');
            const amountInput = document.getElementById('amount');
            const priceResultCard = document.getElementById('priceResultCard');
            const btnPrint = document.getElementById('btnPrint');
            const unitPriceLabel = document.getElementById('unitPriceLabel');
            const amountLabel = document.getElementById('amountLabel');
            const amountHelp = document.getElementById('amountHelp');
            const calculatedTotal = document.getElementById('calculatedTotal');
            const scaleForm = document.getElementById('scaleForm');

            searchInput.addEventListener('input', function() {
                const val = this.value;
                const option = document.querySelector('#productsList option[value="' + val.replace(/"/g, '\\"') + '"]');
                
                if (option) {
                    // Valid product selected
                    productIdInput.value = option.getAttribute('data-id');
                    const price = parseFloat(option.getAttribute('data-price'));
                    const isPesable = option.getAttribute('data-pesable') === 'true';
                    
                    productPriceInput.value = price;
                    isPesableInput.value = isPesable;

                    amountGroup.style.display = 'block';
                    amountInput.value = '';
                    priceResultCard.style.display = 'none';
                    btnPrint.disabled = true;
                    
                    unitPriceLabel.textContent = 'Precio base: $' + price.toLocaleString('es-AR', { minimumFractionDigits: 2 });

                    if (isPesable) {
                        amountLabel.textContent = '2. Peso (kg)';
                        amountInput.setAttribute('step', '0.001');
                        amountInput.setAttribute('min', '0.001');
                        amountHelp.textContent = 'Ejemplo: Para 250 gramos, escribe 0.250';
                    } else {
                        amountLabel.textContent = '2. Cantidad (Unidades)';
                        amountInput.setAttribute('step', '1');
                        amountInput.setAttribute('min', '1');
                        amountHelp.textContent = 'Ejemplo: Para 3 unidades, escribe 3';
                    }
                    
                    amountInput.focus();
                } else {
                    productIdInput.value = '';
                    amountGroup.style.display = 'none';
                    priceResultCard.style.display = 'none';
                    btnPrint.disabled = true;
                }
            });

            amountInput.addEventListener('input', function() {
                let amount = parseFloat(this.value);
                const price = parseFloat(productPriceInput.value);
                
                if (!isNaN(amount) && amount > 0) {
                    const isPesable = isPesableInput.value === 'true';
                    let total = 0;
                    
                    if (isPesable) {
                        total = amount * price;
                    } else {
                        amount = Math.floor(amount);
                        this.value = amount;
                        total = amount * price;
                    }

                    calculatedTotal.textContent = '$' + total.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    priceResultCard.style.display = 'block';
                    btnPrint.disabled = false;
                } else {
                    priceResultCard.style.display = 'none';
                    btnPrint.disabled = true;
                }
            });
            
            scaleForm.addEventListener('submit', function(e) {
                if (!productIdInput.value) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Debes seleccionar un producto válido de la lista.'
                    });
                }
            });
        });
    </script>
}
