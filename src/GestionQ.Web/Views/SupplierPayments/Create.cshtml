@model GestionQ.Domain.Entities.SupplierPayment

@{
    ViewData["Title"] = "Registrar Pago a Proveedor";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title" style="margin-bottom: 0;">Registrar Pago a Proveedor</h1>
    <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId" class="btn-secondary">Volver al Proveedor</a>
</div>

<div class="glass-panel" style="max-width: 800px; margin: 0 auto;">
    <h2 style="margin-top: 0; color: var(--accent);">@ViewBag.SupplierName</h2>
    <div style="opacity: 0.7; margin-bottom: 1.5rem;">Saldo de Deuda Actual: <strong style="color: #ef4444;">@(((decimal)ViewBag.SupplierBalance).ToString("C2"))</strong></div>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="SupplierId" />
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem; color: #ef4444;"></div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div>
                <label asp-for="Date" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                <input asp-for="Date" type="date" class="form-control" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;" />
                <span asp-validation-for="Date" class="text-danger" style="color: #ef4444; font-size: 0.8rem;"></span>
            </div>
            
            <div>
                <label asp-for="PurchaseId" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                <select asp-for="PurchaseId" class="form-control" asp-items="ViewBag.UnpaidPurchases" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;">
                    <option value="">-- Pago a Cuenta Corriente (Sin Factura) --</option>
                </select>
                <span asp-validation-for="PurchaseId" class="text-danger" style="color: #ef4444; font-size: 0.8rem;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div>
                <label asp-for="Amount" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); opacity: 0.5;">$</span>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" style="width: 100%; padding: 0.8rem 0.8rem 0.8rem 2rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;" />
                </div>
                <span asp-validation-for="Amount" class="text-danger" style="color: #ef4444; font-size: 0.8rem;"></span>
            </div>

            <div>
                <label asp-for="PaymentMethodId" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                <select asp-for="PaymentMethodId" id="PaymentMethodId" class="form-control" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;">
                    <option value="">-- Seleccionar Medio de Pago --</option>
                    @foreach (var pm in ViewBag.PaymentMethods)
                    {
                        <option value="@pm.Id" data-name="@pm.Name.ToLower()">@pm.Name</option>
                    }
                </select>
                <span asp-validation-for="PaymentMethodId" class="text-danger" style="color: #ef4444; font-size: 0.8rem;"></span>
            </div>
        </div>

        <div id="transferFields" style="display: none; margin-bottom: 1.5rem; padding: 1.5rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
            <label asp-for="ReferenceNumber" class="control-label" style="display: block; margin-bottom: 0.5rem;">Nro. de Transferencia / Comprobante</label>
            <input asp-for="ReferenceNumber" class="form-control" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;" />
            <span asp-validation-for="ReferenceNumber" class="text-danger" style="color: #ef4444; font-size: 0.8rem;"></span>
        </div>

        <div id="checkFields" style="display: none; margin-bottom: 1.5rem; padding: 1.5rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                <div>
                    <label asp-for="CheckNumber" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                    <input asp-for="CheckNumber" class="form-control" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;" />
                </div>
                <div>
                    <label asp-for="CheckBank" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                    <input asp-for="CheckBank" class="form-control" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;" />
                </div>
                <div>
                    <label asp-for="CheckDueDate" class="control-label" style="display: block; margin-bottom: 0.5rem;"></label>
                    <input asp-for="CheckDueDate" type="date" class="form-control" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;" />
                </div>
            </div>
        </div>

        <div style="margin-bottom: 2rem;">
            <label asp-for="Notes" class="control-label" style="display: block; margin-bottom: 0.5rem;">Observaciones</label>
            <textarea asp-for="Notes" class="form-control" rows="3" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white;"></textarea>
        </div>

        <div style="text-align: right;">
            <button type="submit" class="btn-primary" style="padding: 0.8rem 2rem; font-size: 1.1rem; background: #10b981; border: none;">Guardar Pago</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var methodSelect = document.getElementById("PaymentMethodId");
            var transferFields = document.getElementById("transferFields");
            var checkFields = document.getElementById("checkFields");

            function toggleFields() {
                var selectedOption = methodSelect.options[methodSelect.selectedIndex];
                var methodName = selectedOption ? selectedOption.getAttribute("data-name") : "";
                
                transferFields.style.display = "none";
                checkFields.style.display = "none";

                if (methodName && (methodName.includes("transferencia") || methodName.includes("deposito"))) {
                    transferFields.style.display = "block";
                } else if (methodName && methodName.includes("cheque")) {
                    checkFields.style.display = "block";
                }
            }

            methodSelect.addEventListener("change", toggleFields);
            toggleFields(); // Initial run
        });
    </script>
}

